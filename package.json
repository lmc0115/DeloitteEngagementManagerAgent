{
  "name": "consulting-qa-reviewer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Consulting Deliverable QA Reviewer — LLM quality control for mini-decks and memos",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "build": "npm run build --prefix client",
    "start": "npm run start --prefix server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
