# Get your API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here

# Primary model (free tier):
#   gemma-4-26b-a4b-it     — good for large prompts; may hit 500 errors when busy
#   gemini-2.0-flash-lite  — most stable for demos
GEMINI_MODEL=gemma-4-26b-a4b-it

# Auto-fallback if primary fails (500/503/429)
GEMINI_FALLBACK_MODELS=gemini-2.0-flash-lite,gemini-2.0-flash

# Optional: lower if you still hit 429 errors
# GEMINI_MAX_INPUT_CHARS=28000

# Max tokens for the QA report (default 32768 if unset). Use 65536 for very long reports.
# Set to 0 or "unlimited" to omit the cap and use each model's API maximum.
GEMINI_MAX_OUTPUT_TOKENS=32768

PORT=3001
